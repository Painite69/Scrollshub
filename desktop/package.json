{
  "name": "questhub-desktop",
  "private": true,
  "version": "0.1.2",
  "description": "ScrollsHub desktop app + overlay",
  "author": "Painite",
  "main": "dist/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "start:built": "cross-env QUESTHUB_USE_BUILT=1 electron .",
    "dev": "npm run build:main && concurrently -k -n web,electron -c cyan,magenta \"npm run dev --prefix .. -- --port 5173 --strictPort\" \"wait-on http-get://localhost:5173 && electron .\"",
    "dist:win": "npm run build:main && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "build": {
    "appId": "com.painite.scrollshub",
    "productName": "ScrollsHub",
    "copyright": "Copyright © Painite",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "build/icon.ico"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Painite69",
        "repo": "Scrollshub"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ScrollsHub",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "typescript": "~6.0.2",
    "wait-on": "^8.0.5"
  }
}
